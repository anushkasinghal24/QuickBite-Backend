SPRING_APPLICATION_NAME=payment-service
SERVER_PORT=8084

QUICKBITE_PAYMENT_DB_URL=jdbc:mysql://localhost:3306/quickbite_payment?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
QUICKBITE_PAYMENT_DB_USERNAME=root
QUICKBITE_PAYMENT_DB_PASSWORD=change-me
QUICKBITE_PAYMENT_DB_DRIVER=com.mysql.cj.jdbc.Driver
QUICKBITE_PAYMENT_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

QUICKBITE_MAIL_HOST=smtp.gmail.com
QUICKBITE_MAIL_PORT=587
QUICKBITE_MAIL_USERNAME=your-email@example.com
QUICKBITE_MAIL_PASSWORD=your-mail-app-password

QUICKBITE_RABBITMQ_HOST=localhost
QUICKBITE_RABBITMQ_PORT=5672
QUICKBITE_RABBITMQ_USERNAME=guest
QUICKBITE_RABBITMQ_PASSWORD=guest

QUICKBITE_EUREKA_URL=http://localhost:8761/eureka/
QUICKBITE_PAYMENT_JWT_SECRET=replace-with-a-long-base64-secret
QUICKBITE_PAYMENT_JWT_EXPIRATION=86400000

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
