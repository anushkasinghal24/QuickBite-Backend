# QuickBite order-service local environment
# Copy this file to .env and keep the real values local.

SPRING_APPLICATION_NAME=order-service
SERVER_PORT=8085

QUICKBITE_ORDER_DB_URL=jdbc:mysql://localhost:3306/quickbite_orders?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
QUICKBITE_ORDER_DB_USERNAME=root
QUICKBITE_ORDER_DB_PASSWORD=change-me
QUICKBITE_ORDER_DB_DRIVER=com.mysql.cj.jdbc.Driver
QUICKBITE_ORDER_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

QUICKBITE_RABBITMQ_HOST=localhost
QUICKBITE_RABBITMQ_PORT=5672
QUICKBITE_RABBITMQ_USERNAME=guest
QUICKBITE_RABBITMQ_PASSWORD=guest

QUICKBITE_EUREKA_URL=http://localhost:8761/eureka/
QUICKBITE_ORDER_JWT_SECRET=replace-with-a-long-base64-secret
QUICKBITE_ORDER_JWT_EXPIRATION=86400000
