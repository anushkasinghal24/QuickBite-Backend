# QuickBite auth-service local environment
# Copy this file to .env and keep the real values local.

QUICKBITE_AUTH_DB_URL=jdbc:mysql://localhost:3306/quickbite_auth?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
QUICKBITE_AUTH_DB_USERNAME=root
QUICKBITE_AUTH_DB_PASSWORD=change-me
QUICKBITE_AUTH_DB_DRIVER=com.mysql.cj.jdbc.Driver
QUICKBITE_AUTH_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

QUICKBITE_GOOGLE_CLIENT_ID=your-google-client-id
QUICKBITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
QUICKBITE_GITHUB_CLIENT_ID=your-github-client-id
QUICKBITE_GITHUB_CLIENT_SECRET=your-github-client-secret

QUICKBITE_AUTH_JWT_SECRET=replace-with-a-long-base64-secret
QUICKBITE_FRONTEND_URL=http://localhost:4200
QUICKBITE_AUTH_GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
QUICKBITE_AUTH_GITHUB_REDIRECT_URI=http://localhost:8081/login/oauth2/code/github
QUICKBITE_EUREKA_URL=http://localhost:8761/eureka/
