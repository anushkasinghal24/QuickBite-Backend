SERVER_PORT=8081
SPRING_APPLICATION_NAME=auth-service

QUICKBITE_AUTH_DB_URL=jdbc:mysql://localhost:3306/quickbite_auth?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
QUICKBITE_AUTH_DB_USERNAME=root
QUICKBITE_AUTH_DB_PASSWORD=
QUICKBITE_AUTH_DB_DRIVER=com.mysql.cj.jdbc.Driver

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
APP_FRONTEND_URL=http://localhost:4200

APP_JWT_SECRET=replace-with-base64-secret
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
